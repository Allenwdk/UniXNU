diff --git a/bsd/miscfs/bindfs/bind_vnops.c b/bsd/miscfs/bindfs/bind_vnops.c
--- a/bsd/miscfs/bindfs/bind_vnops.c
+++ b/bsd/miscfs/bindfs/bind_vnops.c
@@ -189,6 +189,34 @@
  * as we progress through the tree. We also have to enforce read-only
  * if this layer is mounted read-only.
  */
+#if CONFIG_UNION_MOUNTS
+/* Called by the existing VFS union lookup and directory enumeration paths.
+ * Return ENOTSUP for an ordinary bind mount so its covered-directory semantics
+ * remain unchanged. The caller keeps its existing search/read authorization. */
+int
+native_bindfs_union_lower(vnode_t vp, vnode_t *new_vp, vfs_context_t ctx)
+{
+	char fsname[MFSTYPENAMELEN];
+	vnode_vfsname(vp, fsname);
+	if (strcmp(fsname, "bindfs") ||
+	    !(MOUNTTOBINDMOUNT(vnode_mount(vp))->bindm_flags & BINDM_UNION_SOURCE)) {
+		return ENOTSUP;
+	}
+	vnode_t lower = BINDVPTOLOWERVP(vp);
+	int error = vnode_getwithref(lower);
+	if (error) {
+		return error;
+	}
+	if (vfs_flags(vnode_mount(lower)) & MNT_UNION) {
+		error = lookup_traverse_union(lower, new_vp, ctx);
+	} else {
+		error = ENOENT;
+	}
+	vnode_put(lower);
+	return error;
+}
+#endif
+
