 };
 
 static tu_panel_tile_result
@@ -3986,7 +3991,7 @@
 
    for (unsigned i = 0; i < subpass.resolve_count; i++) {
       if (subpass.resolve_attachments[i].attachment != VK_ATTACHMENT_UNUSED)
-         return TU_PANEL_TILES_ATTACHMENT_OPS;
+         return TU_PANEL_TILES_RESOLVE;
    }
 
    const uint32_t screen = subpass.color_attachments[0].attachment;
@@ -4005,14 +4010,26 @@
    if (!view->image->mem ||
        view->image->mem->vk.import_handle_type != VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT)
       return TU_PANEL_TILES_SURFACE_IMPORT;
