  */
 enum tu_panel_tile_result {
    TU_PANEL_TILES_NOT_PROFILED,
@@ -3954,6 +3954,11 @@
    TU_PANEL_TILES_SURFACE_LAYOUT,
    TU_PANEL_TILES_ATTACHMENT_OPS,
