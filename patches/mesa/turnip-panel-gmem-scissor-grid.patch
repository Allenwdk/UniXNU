+/* A fixed conservative grid works for both primary and secondary buffers.
+ * Cells touching a scissor are marked even when the scissor only covers an edge.
+ */
+static constexpr uint32_t PANEL_CELL_W = 100;
+static constexpr uint32_t PANEL_CELL_H = 68;
+
+static uint32_t
+tu_panel_cell_mask(uint32_t first, uint32_t end)
+{
+   return (uint32_t)(((UINT64_C(1) << end) - 1) ^ ((UINT64_C(1) << first) - 1));
+}
+
+static bool
+tu_panel_tile_touched(const tu_render_pass_state &rp, VkExtent2D tile,
+                      uint32_t tx, uint32_t ty)
+{
+   const uint32_t x0 = tx * tile.width, y0 = ty * tile.height;
+   const uint32_t x1 = x0 + tile.width, y1 = y0 + tile.height;
+   const auto &bounds = rp.draw_bounds;
+   if (x1 <= bounds[0] || y1 <= bounds[1] || x0 >= bounds[2] || y0 >= bounds[3])
+      return false;
+
+   const uint32_t mask = tu_panel_cell_mask(x0 / PANEL_CELL_W,
+                                          DIV_ROUND_UP(MIN2(x1, 3200u), PANEL_CELL_W));
+   for (uint32_t y = y0 / PANEL_CELL_H;
+        y < DIV_ROUND_UP(MIN2(y1, 2136u), PANEL_CELL_H); y++) {
+      if (rp.panel_scissor_rows[y] & mask)
+         return true;
+   }
+   return false;
 }
 
