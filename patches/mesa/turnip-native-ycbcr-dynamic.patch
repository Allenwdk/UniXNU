+/* TU_NATIVE_YCBCR: the dword of a sampled image's descriptor element that holds its Y'CbCr
+ * conversion's state, past the four to eleven dwords the texture unit reads (fdl6_view has
+ * sixteeen). What the state says, which tu_shader.cc takes apart:
+ *   bits 0-1  the codes' bits: 0 eight, 1 ten
+ *   bit 2     full range where set, the ITU narrow (video) range otherwise
+ *   bits 3-4  the model: 0 BT.601, 1 BT.709, 2 BT.2020
+ *   bit 5     set where the element's image view has such a conversion at all
+ */
+#define TU_YCBCR_STATE_DWORD 15
+#define TU_YCBCR_STATE_BITS_MASK 0x3u
+#define TU_YCBCR_STATE_FULL_RANGE (1u << 2)
+#define TU_YCBCR_STATE_MODEL_SHIFT 3
+#define TU_YCBCR_STATE_MODEL_MASK 0x3u
+#define TU_YCBCR_STATE_VALID (1u << 5)
+
+static inline uint32_t
+tu_ycbcr_state_word(VkFormat format,
+                    VkSamplerYcbcrModelConversion model,
+                    VkSamplerYcbcrRange range)
+{
+   uint32_t bits;
+
+   switch (format) {
+   case VK_FORMAT_G8_B8R8_2PLANE_420_UNORM:
+   case VK_FORMAT_G8_B8R8_2PLANE_422_UNORM:
+   case VK_FORMAT_G8_B8R8_2PLANE_444_UNORM:
+      bits = 0;
+      break;
+   case VK_FORMAT_G10X6_B10X6R10X6_2PLANE_420_UNORM_3PACK16:
+   case VK_FORMAT_G10X6_B10X6R10X6_2PLANE_422_UNORM_3PACK16:
+   case VK_FORMAT_G10X6_B10X6R10X6_2PLANE_444_UNORM_3PACK16:
+      bits = 1;
+      break;
+   default:
+      /* One plane, three planes, or codes the conversion below does not take: nothing to say,
+       * and the shader reads the descriptor's samples as the image holds them. */
+      return 0;
+   }
+
+   uint32_t model_bits;
+
+   switch (model) {
+   case VK_SAMPLER_YCBCR_MODEL_CONVERSION_YCBCR_601:
+      model_bits = 0;
+      break;
+   case VK_SAMPLER_YCBCR_MODEL_CONVERSION_YCBCR_709:
+      model_bits = 1;
+      break;
+   case VK_SAMPLER_YCBCR_MODEL_CONVERSION_YCBCR_2020:
+      model_bits = 2;
+      break;
+   default:
+      return 0;
+   }
+
+   return TU_YCBCR_STATE_VALID | bits |
+          (range == VK_SAMPLER_YCBCR_RANGE_ITU_FULL ? TU_YCBCR_STATE_FULL_RANGE : 0) |
+          (model_bits << TU_YCBCR_STATE_MODEL_SHIFT);
+}
