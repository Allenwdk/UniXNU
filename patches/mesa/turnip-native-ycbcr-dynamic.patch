+/* One of four floats, chosen by the two conditions the caller holds (a bpc and a range bit). */
+static nir_def *
+select_four(nir_builder *b, nir_def *ten, nir_def *full,
+            float eight_narrow, float eight_full, float ten_narrow, float ten_full)
+{
+   nir_def *eight = nir_bcsel(b, full, nir_imm_float(b, eight_full),
+                              nir_imm_float(b, eight_narrow));
+   nir_def *ten_ = nir_bcsel(b, full, nir_imm_float(b, ten_full),
+                             nir_imm_float(b, ten_narrow));
+   return nir_bcsel(b, ten, ten_, eight);
+}
+
+/* The converted and expanded channels of a sample of a Y'CbCr image, by the state word the image's
+ * descriptor element carries (tu_device.h): the same coefficients `nir_convert_ycbcr_to_rgb` bakes,
+ * selected at run time because under a dynamically indexed sample they are not known when the
+ * shader is made. The sample's channels are Metal's (Cr, Y, Cb, A). */
+static nir_def *
+ycbcr_state_to_rgb(nir_builder *b, nir_def *state, nir_def *raw)
+{
+   float range_coeffs[2][2][3][2]; /* [bpc: 8, 10][range: narrow, full][Y, Cb, Cr][scale, offset] */
+   float matrices[3][3][4];        /* [model: 601, 709, 2020][channel][Y, Cb, Cr, unused] */
+
+   for (unsigned ten = 0; ten < 2; ten++) {
+      const unsigned bpc[3] = {ten ? 10 : 8, ten ? 10 : 8, ten ? 10 : 8};
+      util_get_narrow_range_coeffs(range_coeffs[ten][0], bpc);
+      util_get_full_range_coeffs(range_coeffs[ten][1], bpc);
+   }
+   util_get_ycbcr_to_rgb_matrix(matrices[0], util_ycbcr_bt601_coeffs);
+   util_get_ycbcr_to_rgb_matrix(matrices[1], util_ycbcr_bt709_coeffs);
+   util_get_ycbcr_to_rgb_matrix(matrices[2], util_ycbcr_bt2020_coeffs);
+
+   nir_def *ten = nir_ine_imm(b, nir_iand_imm(b, state, TU_YCBCR_STATE_BITS_MASK), 0);
+   nir_def *full = nir_ine_imm(b, nir_iand_imm(b, state, TU_YCBCR_STATE_FULL_RANGE), 0);
+   nir_def *model = nir_iand_imm(b, nir_ishr_imm(b, state, TU_YCBCR_STATE_MODEL_SHIFT),
+                                 TU_YCBCR_STATE_MODEL_MASK);
+   nir_def *is_709 = nir_ieq_imm(b, model, 1);
+   nir_def *is_2020 = nir_ieq_imm(b, model, 2);
+
+   nir_def *scale[3], *offset[3];
+   for (unsigned ch = 0; ch < 3; ch++) {
+      scale[ch] = select_four(b, ten, full,
+                              range_coeffs[0][0][ch][0], range_coeffs[0][1][ch][0],
+                              range_coeffs[1][0][ch][0], range_coeffs[1][1][ch][0]);
+      offset[ch] = select_four(b, ten, full,
+                               range_coeffs[0][0][ch][1], range_coeffs[0][1][ch][1],
+                               range_coeffs[1][0][ch][1], range_coeffs[1][1][ch][1]);
+   }
+
+   nir_def *expanded = nir_vec4(b,
+      nir_ffma(b, nir_channel(b, raw, 0), scale[2], offset[2]),
+      nir_ffma(b, nir_channel(b, raw, 1), scale[0], offset[0]),
+      nir_ffma(b, nir_channel(b, raw, 2), scale[1], offset[1]),
+      nir_channel(b, raw, 3));
+
+   nir_def *converted[3];
+   for (unsigned ch = 0; ch < 3; ch++) {
+      nir_def *weights[3];
+      for (unsigned i = 0; i < 3; i++) {
+         weights[i] = nir_bcsel(b, is_2020, nir_imm_float(b, matrices[2][ch][i]),
+                                nir_bcsel(b, is_709, nir_imm_float(b, matrices[1][ch][i]),
+                                          nir_imm_float(b, matrices[0][ch][i])));
+      }
+      converted[ch] = nir_fdot(b, expanded,
+                               nir_vec4(b, weights[2], weights[0], weights[1],
+                                        nir_imm_float(b, 0.0f)));
+   }
+
+   return nir_vec4(b, converted[0], converted[1], converted[2],
+                   nir_channel(b, raw, 3));
+}
+
+/* TU_NATIVE_YCBCR: a sample of a dynamically indexed image (a bindless array's element) whose
+ * image view has a Y'CbCr conversion converts here, from the state word the view's descriptor
+ * element carries: `lower_tex_immutable` reaches only a constant index, and a consumer that picks
+ * the index at draw time (Metal's gpuResourceID) has none. The word is the draw's, so the
+ * coefficients it selects cost one path; an element whose word says no conversion keeps the
+ * sample's own channels. */
+static void
+lower_tex_ycbcr_state(struct tu_device *dev, struct tu_shader *shader,
+                      struct ir3_const_allocations *const_allocs,
+                      nir_builder *b, nir_tex_instr *tex)
+{
+   if (!dev->native_ycbcr)
+      return;
+   if (tex->op == nir_texop_txs || tex->op == nir_texop_query_levels ||
+       tex->op == nir_texop_lod)
+      return;
+
+   int tex_src_idx = nir_tex_instr_src_index(tex, nir_tex_src_texture_handle);
+   if (tex_src_idx < 0)
+      return;
+   nir_def *handle = tex->src[tex_src_idx].src.ssa;
+   if (!nir_def_is_intrinsic(handle))
+      return;
+   nir_intrinsic_instr *intr = nir_def_as_intrinsic(handle);
+   if (intr->intrinsic != nir_intrinsic_bindless_resource_ir3)
+      return;
+   /* A constant index is the immutable-sampler lowering's. */
+   if (nir_src_is_const(intr->src[0]))
+      return;
+
+   const unsigned set = nir_intrinsic_desc_set(intr);
+   nir_def *set_base;
+   if (dev->compiler->info->props.load_shader_consts_via_preamble) {
+      set_base = ir3_load_driver_ubo(b, 2, &shader->const_state.bindless_base_addrs_ubo,
+                                     set * 2);
+   } else {
+      const unsigned dword_base =
+         const_allocs->consts[IR3_CONST_ALLOC_BINDLESS_BASE_ADDRS].offset_vec4 * 4 + set * 2;
+      set_base = nir_load_const_ir3(b, 2, 32, nir_imm_int(b, 0), .base = dword_base);
+   }
+
+   b->cursor = nir_before_instr(&tex->instr);
+   nir_def *at = nir_iadd_imm(b, nir_imul_imm(b, intr->src[0].ssa, FDL6_TEX_CONST_DWORDS * 4),
+                              TU_YCBCR_STATE_DWORD * 4);
+   nir_def *state = nir_load_global_ir3(b, 1, 32, nir_pack_64_2x32(b, set_base), at,
+      .access = (enum gl_access_qualifier)(
+         ACCESS_NON_WRITEABLE | ACCESS_CAN_REORDER | ACCESS_CAN_SPECULATE),
+      .align_mul = 4, .align_offset = 0);
+
+   nir_def *valid = nir_ine_imm(b, nir_iand_imm(b, state, TU_YCBCR_STATE_VALID), 0);
+   nir_push_if(b, valid);
+   nir_def *converted = ycbcr_state_to_rgb(b, state, &tex->def);
+   nir_pop_if(b, NULL);
+
+   nir_def_rewrite_uses_after(&tex->def,
+                              nir_if_phi(b, converted, &tex->def));
+}
